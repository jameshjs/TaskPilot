{
  "manifest_version": 3,
  "name": "TaskPilot",
  "version": "0.1.0",
  "description": "An AI browser agent that understands your goal, organizes your tabs around it, guides you through websites, and keeps you focused.",
  "minimum_chrome_version": "121",
  "permissions": ["tabs", "tabGroups", "sidePanel", "storage", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open TaskPilot" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" } }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
