{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["chrome", "vitest/globals"],
    "isolatedModules": true
  },
  "include": ["src", "shared", "tests", "build.d.ts"],
  // Backend tests import Worker code, whose globals (Request/Response/fetch) clash with
  // the DOM lib above. They are typechecked by backend/tsconfig.json instead.
  "exclude": ["tests/workflow.test.ts"]
}
